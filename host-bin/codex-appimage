#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${AGENT_HARNESS_T3_CONFIG_DIR:-$HOME/.config/agent-harness/t3-agent}"
TARGET_FILE="${AGENT_HARNESS_T3_TARGET_FILE:-${CONFIG_DIR}/codex-target}"
DEFAULT_TARGET="${AGENT_HARNESS_T3_CODEX_TARGET:-container}"

resolve_target() {
  if [[ -f "${TARGET_FILE}" ]]; then
    tr -d '[:space:]' < "${TARGET_FILE}"
    return
  fi
  printf '%s' "${DEFAULT_TARGET}"
}

target="$(resolve_target)"

case "${target}" in
  container)
    exec "${HOME}/.local/bin/codex-remote" "$@"
    ;;
  host)
    exec "${HOME}/.local/bin/codex-host" "$@"
    ;;
  *)
    printf 'unsupported codex target: %s\n' "${target}" >&2
    printf 'expected one of: host, container\n' >&2
    exit 1
    ;;
esac
