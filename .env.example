# Copy this file to .env and adjust paths if you want to run `docker compose`
# directly. The helper scripts under `scripts/` set sensible defaults for local use.

COMPOSE_PROJECT_NAME=agent-harness

# Required
WORKSPACE_MODE=local-bind
HOST_WORKSPACE_ROOT=/home/your-user
CONTAINER_WORKSPACE_ROOT=/home/workspaces
AGENT_UID=1000
AGENT_GID=1000
T3_WEB_PORT=3773
AGENT_SSH_PORT=47722

# Strongly recommended when using `docker compose` directly.
T3_AGENT_PRIVATE_KEY_PATH=/home/your-user/.config/agent-harness/t3-agent/id_ed25519
T3_AGENT_PUBLIC_KEY_PATH=/home/your-user/.config/agent-harness/t3-agent/id_ed25519.pub

# Optional
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_SERVER_PASSWORD=
TZ=UTC
