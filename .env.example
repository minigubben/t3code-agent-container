# Copy this file to .env to configure `docker compose`.

COMPOSE_PROJECT_NAME=agent-harness

# Required
HOST_WORKSPACE_ROOT=/home/your-user/dev_workspace
CONTAINER_WORKSPACE_NAME=dev_workspace
AGENT_UID=1000
AGENT_GID=1000
T3_WEB_PORT=3773

# Optional but useful for AppImage pairing links.
T3_PUBLIC_BASE_URL=http://127.0.0.1:3773

# Optional
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# Optional GitHub App authentication. The private-key value is sensitive; this
# .env file is gitignored. Generate its base64 form with: base64 -w0 app.pem
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_B64=
# Usually leave blank: the helper derives the installation from origin.
# Set this only when the current directory has no git remote.
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_REPOSITORY=
# GitHub Enterprise Server users may override this API base URL.
GITHUB_APP_API_URL=

OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_SERVER_PASSWORD=
TZ=UTC
