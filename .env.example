# Copy this file to .env if you want to run `docker compose` directly.
# The helper scripts under `scripts/` set sensible defaults for local use.

COMPOSE_PROJECT_NAME=agent-harness

# Required
WORKSPACE_MODE=local-bind
HOST_WORKSPACE_ROOT=/home/your-user
CONTAINER_WORKSPACE_ROOT=/home/workspaces
AGENT_UID=1000
AGENT_GID=1000
T3_WEB_PORT=3773

# Optional but useful for AppImage pairing links.
T3_PUBLIC_BASE_URL=http://127.0.0.1:3773

# Optional
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_SERVER_PASSWORD=
TZ=UTC
