#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/common.sh"

usage() {
  printf 'usage: %s <path> [--title <title>]\n' "$0" >&2
  exit 1
}

load_env
require_command docker

[[ $# -ge 1 ]] || usage

workspace_root="$1"
shift

cmd=(t3 project add "${workspace_root}" --base-dir /home/agent/.t3)
while [[ $# -gt 0 ]]; do
  case "$1" in
    --title)
      [[ $# -ge 2 ]] || usage
      cmd+=(--title "$2")
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

printf -v quoted_cmd '%q ' "${cmd[@]}"
compose_cmd exec -T --user agent agent bash -lc "${quoted_cmd}"
