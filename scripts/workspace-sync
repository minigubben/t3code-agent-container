#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/common.sh"

usage() {
  printf 'usage: %s push <local-path> <container-path>\n' "$0" >&2
  printf '       %s pull <container-path> <local-path>\n' "$0" >&2
  exit 1
}

load_env

[[ $# -eq 3 ]] || usage
[[ "${WORKSPACE_MODE}" == "remote-volume" ]] || {
  printf 'workspace-sync only applies to WORKSPACE_MODE=remote-volume\n' >&2
  exit 1
}

direction="$1"
src="$2"
dst="$3"

case "${direction}" in
  push)
    [[ -e "${src}" ]] || {
      printf 'source path does not exist: %s\n' "${src}" >&2
      exit 1
    }
    if [[ "${dst}" != /* ]]; then
      dst="${CONTAINER_WORKSPACE_ROOT%/}/${dst}"
    fi
    printf -v quoted_dst '%q' "${dst}"
    compose_cmd exec -T agent bash -lc "mkdir -p \$(dirname ${quoted_dst})"
    compose_cmd cp "${src}" "agent:${dst}"
    compose_cmd exec -T agent bash -lc "chown -R agent:agent ${quoted_dst}"
    ;;
  pull)
    if [[ "${src}" != /* ]]; then
      src="${CONTAINER_WORKSPACE_ROOT%/}/${src}"
    fi
    compose_cmd cp "agent:${src}" "${dst}"
    ;;
  *)
    usage
    ;;
esac
